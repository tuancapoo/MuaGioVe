[node name="Body" type="Label" parent="HUD/GuideOverlay/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.97, 0.88, 1)
theme_override_fonts/font = ExtResource("Font_vt")
theme_override_font_sizes/font_size = 34
text = "1. Quan sát mặt nước để tìm gợn sóng hoặc bóng cá di chuyển.
2. Căn chỉnh điểm thả cần rồi thả phao xuống đúng chỗ có cá.
3. Đợi phao thụt xuống và hiện dấu '!' thì bấm giật cần đúng lúc!

• Chuột / Phím: Di chuột hoặc A/D/W/S chọn chỗ · Click trái / E thả & giật cần
• Tay cầm: Analog trái chọn chỗ · A thả & giật · X nhờ Na · Back hướng dẫn
• Mẹo: Bấm [Space / X] để Nhờ Na chỉ vị trí cá (hồi 15 giây)."
autowrap_mode = 2

